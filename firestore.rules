rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test collection for initial connectivity ping
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // PII protection: blanket listing forbidden
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(taskId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(taskId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(taskId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(subjectId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(subjectId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(subjectId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Topics Collection
    match /topics/{topicId} {
      allow get: if isValidId(topicId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(topicId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(topicId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(topicId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Study Sessions Collection
    match /studySessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(sessionId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Quiz Results Collection
    match /quizResults/{quizId} {
      allow get: if isValidId(quizId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(quizId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(quizId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(quizId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // Session State (LOCKDIN Chrome Extension & Web synchronization)
    match /sessionState/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) && incoming().userId == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) && incoming().userId == existing().userId;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Achievements Collection
    match /achievements/{achievementId} {
      allow get: if isValidId(achievementId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(achievementId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(achievementId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isValidId(achievementId) && isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
